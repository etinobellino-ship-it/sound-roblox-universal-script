--[[
    CLICK GHOST RECORDER per Xeno Executor
    Registra click del mouse sinistro e li riproduce senza spostare il cursore.
    Perfetto per comprare oggetti quando tornano in stock (uova, ecc.).
    
    ISTRUZIONI:
    1. Incolla questo script nell'editor di Xeno.
    2. Esegui.
    3. Usa la GUI per registrare i click e riprodurli in loop.
]]

-- ============================================================
-- SERVIZI
-- ============================================================
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ============================================================
-- STATO
-- ============================================================
local clicks = {}          -- tabella dei click registrati {x, y}
local isRecording = false
local isPlaying = false
local isLooping = false
local recordConnection = nil

-- ============================================================
-- GUI
-- ============================================================
