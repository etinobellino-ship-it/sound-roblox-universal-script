--[[
    CLICK GHOST RECORDER + GLOBAL SOUND BROADCAST
    FIXED VERSION FOR Xeno Executor / Roblox

    IMPORTANTE:
    - Il click recorder funziona come LocalScript.
    - Per far sentire il suono a tutti i giocatori, serve un RemoteEvent + un Script server.
    - Incolla la parte LOCAL nel tuo LocalScript e la parte SERVER in un Script dentro ServerScriptService.
]]

-- ============================================================
-- LOCAL SCRIPT (StarterPlayerScripts)
-- ============================================================
local UserInputService = game:GetService("UserInputService")
local VirtualInputManager = game:GetService("VirtualInputManager")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local soundFolder = ReplicatedStorage:FindFirstChild("GlobalSound")
if not soundFolder then
    soundFolder = Instance.new("Folder")
    soundFolder.Name = "GlobalSound"
    soundFolder.Parent = ReplicatedStorage
end

local playSoundEvent = soundFolder:FindFirstChild("PlaySound")
if not playSoundEvent then
    playSoundEvent = Instance.new("RemoteEvent")
    playSoundEvent.Name = "PlaySound"
    playSoundEvent.Parent = soundFolder
end

local clicks = {}
local isRecording = false
local isPlaying = false
local isLooping = false
local recordConnection = nil

local DEFAULT_SOUND_ID = "rbxassetid://911309111"

local function playGlobalSound(soundId, volume, pitch)
    if typeof(soundId) ~= "string" or soundId == "" then
        soundId = DEFAULT_SOUND_ID
    end
    if typeof(volume) ~= "number" then
        volume = 0.6
    end
    if typeof(pitch) ~= "number" then
        pitch = 1
    end

    playSoundEvent:FireServer(soundId, math.clamp(volume, 0, 10), math.clamp(pitch, 0.5, 2))
end

local oldGui = playerGui:FindFirstChild("ClickGhostRecorder")
if oldGui then
    oldGui:Destroy()
end

