listPadding.Parent = listFrame

local function updateStatus(text, color)
    statusLabel.Text = text
    statusLabel.TextColor3 = color or Color3.fromRGB(180, 180, 190)
end

local function refreshList()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    for i, click in ipairs(clicks) do
        local entry = Instance.new("TextLabel")
        entry.Size = UDim2.new(1, 0, 0, 28)
        entry.BackgroundColor3 = Color3.fromRGB(30, 30, 38)
        entry.BorderSizePixel = 0
        entry.Text = string.format("  #%d  →  X: %d, Y: %d", i, click.x, click.y)
        entry.TextColor3 = Color3.fromRGB(220, 220, 230)
        entry.TextSize = 13
        entry.Font = Enum.Font.Code
        entry.TextXAlignment = Enum.TextXAlignment.Left
        entry.Parent = listFrame

        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = entry
    end

    local totalHeight = math.max(#clicks * 32 + 12, 200)
    listFrame.CanvasSize = UDim2.new(0, 0, 0, totalHeight)
end

local function startRecording()
    if isRecording then return end
    if isPlaying then
        updateStatus("Ferma la riproduzione prima di registrare.", Color3.fromRGB(255, 180, 80))
        return
    end

    isRecording = true
    updateStatus("🔴 Registrazione in corso... clicca dove vuoi", Color3.fromRGB(255, 100, 100))
    recordBtn.Text = "⏺ REC..."
    recordBtn.BackgroundColor3 = Color3.fromRGB(150, 30, 30)

    recordConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            local pos = input.Position
            table.insert(clicks, { x = math.floor(pos.X), y = math.floor(pos.Y) })
            refreshList()
            updateStatus(string.format("🔴 Registrato click #%d → (%d, %d)", #clicks, pos.X, pos.Y), Color3.fromRGB(255, 120, 120))
            playGlobalSound("rbxassetid://911309111", 0.35, 1.1)
        end
    end)
end

local function stopRecording()
    if not isRecording then return end
    isRecording = false
    if recordConnection then
        recordConnection:Disconnect()
        recordConnection = nil
    end
    recordBtn.Text = "⏺ Registra"
    recordBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    updateStatus(string.format("Registrazione fermata. Click totali: %d", #clicks), Color3.fromRGB(100, 255, 100))
end

local function playClicks()
    if isPlaying then return end
    if #clicks == 0 then
        updateStatus("Nessun click da riprodurre.", Color3.fromRGB(255, 180, 80))
        return
    end

    isPlaying = true
    updateStatus("▶ Riproduzione in corso...", Color3.fromRGB(100, 255, 100))

    for i, click in ipairs(clicks) do
        if not isPlaying then break end

        VirtualInputManager:SendMouseButtonEvent(click.x, click.y, 0, true, game, 1)
        task.wait(0.05)
        VirtualInputManager:SendMouseButtonEvent(click.x, click.y, 0, false, game, 1)

        updateStatus(string.format("▶ Click %d/%d → (%d, %d)", i, #clicks, click.x, click.y), Color3.fromRGB(100, 200, 255))
        task.wait(0.15)
    end

    isPlaying = false
    updateStatus("Riproduzione completata.", Color3.fromRGB(100, 255, 100))
end

local function startLoop()
    if isLooping then return end
    isLooping = true
    loopBtn.Text = "🔁 Loop ON"
    loopBtn.BackgroundColor3 = Color3.fromRGB(50, 120, 200)
    updateStatus("🔁 Loop attivo. Riproduzione continua...", Color3.fromRGB(100, 200, 255))

    task.spawn(function()
        while isLooping do
            if #clicks > 0 and not isPlaying then
                playClicks()
            end
            task.wait(0.5)
        end
    end)
end

local function stopLoop()
    isLooping = false
    loopBtn.Text = "🔁 Loop OFF"
    loopBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
    updateStatus("Loop fermato.", Color3.fromRGB(180, 180, 190))
end

recordBtn.MouseButton1Click:Connect(function()
    if isRecording then
        stopRecording()
    else
        startRecording()
    end
end)

stopBtn.MouseButton1Click:Connect(function()
    if isRecording then stopRecording() end
    if isPlaying then isPlaying = false end
    if isLooping then stopLoop() end
    updateStatus("Tutto fermato.", Color3.fromRGB(180, 180, 190))
end)

playBtn.MouseButton1Click:Connect(function()
    if isRecording then
        updateStatus("Ferma la registrazione prima di riprodurre.", Color3.fromRGB(255, 180, 80))
        return
    end
    playClicks()
end)

loopBtn.MouseButton1Click:Connect(function()
    if isLooping then
        stopLoop()
    else
        startLoop()
    end
end)

clearBtn.MouseButton1Click:Connect(function()
    if isRecording then stopRecording() end
    if isPlaying then isPlaying = false end
    if isLooping then stopLoop() end
    clicks = {}
    refreshList()
    updateStatus("Lista click cancellata.", Color3.fromRGB(180, 180, 190))
end)

refreshList()
updateStatus("Pronto. Premi 'Registra' e clicca con il tasto sinistro.", Color3.fromRGB(180, 180, 190))
print("[Click Ghost Recorder] Caricato con successo.")

-- ============================================================
-- SERVER SCRIPT (Script in ServerScriptService)
-- ============================================================
-- Incolla questo script in un Script dentro ServerScriptService.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local soundFolder = ReplicatedStorage:FindFirstChild("GlobalSound")
if not soundFolder then
    soundFolder = Instance.new("Folder")
    soundFolder.Name = "GlobalSound"
    soundFolder.Parent = ReplicatedStorage
end

local playSoundEvent = soundFolder:FindFirstChild("PlaySound")
if not playSoundEvent then
    playSoundEvent = Instance.new("RemoteEvent")
    playSoundEvent.Name = "PlaySound"
    playSoundEvent.Parent = soundFolder
end

local function playSoundForEveryone(soundId, volume, pitch)
    if typeof(soundId) ~= "string" or soundId == "" then
        return
    end

    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Volume = math.clamp(volume or 1, 0, 10)
    sound.Pitch = math.clamp(pitch or 1, 0.5, 2)
    sound.Parent = game:GetService("SoundService")
    sound:Play()

    task.delay(math.max(sound.TimeLength, 1.5) + 0.2, function()
        if sound and sound.Parent then
            sound:Destroy()
        end
    end)
end

playSoundEvent.OnServerEvent:Connect(function(player, soundId, volume, pitch)
    if not player then
        return
    end

    playSoundForEveryone(soundId, volume, pitch)
end)

print("[Global Sound Server] Pronto. RemoteEvent attivo.")

--[[
    NOTE:
    - Il suono globale deve partire dal server.
    - Il LocalScript chiama FireServer, e il server lo riproduce per tutti.
    - Se vuoi cambiare il suono, modifica la stringa "soundId" o usa un tuo asset id.
]]
