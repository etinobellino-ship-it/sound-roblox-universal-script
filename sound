end

local recordBtn = makeButton("⏺ Registra", Color3.fromRGB(200, 50, 50), 95)
local stopBtn = makeButton("⏹ Stop", Color3.fromRGB(80, 80, 90), 95)
stopBtn.Position = UDim2.new(0.52, 0, 0, 95)

local playBtn = makeButton("▶ Riproduci", Color3.fromRGB(50, 160, 80), 145)
local loopBtn = makeButton("🔁 Loop OFF", Color3.fromRGB(60, 60, 70), 145)
loopBtn.Position = UDim2.new(0.52, 0, 0, 145)

local clearBtn = makeButton("🗑 Cancella", Color3.fromRGB(120, 70, 70), 195)
clearBtn.Size = UDim2.new(0.92, 0, 0, 35)

-- Lista click
local listFrame = Instance.new("ScrollingFrame")
listFrame.Size = UDim2.new(0.92, 0, 0, 200)
listFrame.Position = UDim2.new(0.04, 0, 0, 245)
listFrame.BackgroundColor3 = Color3.fromRGB(15, 15, 20)
listFrame.BorderSizePixel = 0
listFrame.ScrollBarThickness = 6
listFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
