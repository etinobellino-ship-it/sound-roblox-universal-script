--// CREA SPEAKER 3D (FUNZIONANTE)
local function CreaSpeaker3D()
    -- Rimuovi vecchio
    if Stato.SpeakerPart then
        Stato.SpeakerPart:Destroy()
    end
    
    -- Crea part fisica
    local speaker = Instance.new("Part")
    speaker.Name = "Radio3D_Speaker"
    speaker.Size = Vector3.new(2, 2, 2)
    speaker.Shape = Enum.PartType.Ball
    speaker.Material = Enum.Material.Neon
    speaker.Color = Color3.fromRGB(255, 215, 0)
    speaker.CanCollide = false
    speaker.Anchored = true
    speaker.Transparency = 0.5
    speaker.Parent = Workspace
    
    -- Posiziona sopra player
    local char = LocalPlayer.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        speaker.Position = char.HumanoidRootPart.Position + Vector3.new(0, 6, 0)
    end
    
    -- Crea suono 3D IMPORTANTE
    local sound = Instance.new("Sound")
    sound.Name = "Audio3D"
    sound.Parent = speaker -- Parentato alla Part (tutti sentono!)
    sound.Volume = Stato.Volume
    sound.RollOffMode = Enum.RollOffMode.Linear
    sound.RollOffMaxDistance = Stato.Range
    sound.RollOffMinDistance = 5
    sound.Looped = false
    
    -- Effetto visivo range
    local rangeVisual = Instance.new("SelectionSphere")
    rangeVisual.Name = "RangeVisual"
    rangeVisual.Color3 = Color3.fromRGB(255, 215, 0)
    rangeVisual.Transparency = 0.9
    rangeVisual.SurfaceTransparency = 0.9
    rangeVisual.Parent = speaker
    
    -- Segui player
    task.spawn(function()
        while Stato.SpeakerPart and Stato.SpeakerPart.Parent do
            local char = LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local targetPos = char.HumanoidRootPart.Position + Vector3.new(0, 6, 0)
                Stato.SpeakerPart.Position = targetPos
            end
            task.wait(0.03)
        end
    end)
    
    Stato.SpeakerPart = speaker
    Stato.Sound3D = sound
    
    return sound
end

